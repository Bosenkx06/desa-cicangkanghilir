            document.getElementById('stat-total-lahir').innerText = appData.kependudukanLahir.length;
            document.getElementById('stat-total-kegiatan').innerText = appData.laporanSosial.length;

            // Pengumuman
            const pList = document.getElementById('beranda-pengumuman-list');
            pList.innerHTML = appData.pengumuman.slice(0, 2).map(p => `
                <div class="bg-white/10 p-4 rounded-xl backdrop-blur border border-white/10">
                    <span class="text-xs text-amber-300 font-semibold">${p.date}</span>
                    <h4 class="font-bold text-base mt-1">${p.title}</h4>
                    <p class="text-xs text-slate-200 mt-1">${p.content}</p>
                </div>
            `).join('');

            // Laporan Publik
            const lList = document.getElementById('beranda-laporan-list');
            lList.innerHTML = appData.laporanSosial.slice(0, 2).map(item => `
                <div class="bg-slate-50 border rounded-2xl p-4 flex flex-col justify-between">
                    <div>
                        <span class="bg-brand-100 text-brand-800 text-xs font-bold px-2.5 py-1 rounded-md">${item.kategori}</span>
                        <h4 class="font-bold text-base text-slate-900 mt-2">${item.judul}</h4>
                        <p class="text-xs text-slate-500 mt-1"><i class="fas fa-map-marker-alt text-brand-600 mr-1"></i> ${item.rw} / ${item.rt} | <i class="fas fa-calendar mr-1"></i> ${item.tanggal}</p>
                        <p class="text-xs text-slate-700 mt-2">${item.deskripsi}</p>
                    </div>
                </div>
            `).join('');
        }

        // Guestbook Handler
        function handleGuestbookSubmit(e) {
            e.preventDefault();
            const message = document.getElementById('gb-message').value;
            const name = appData.currentUser ? appData.currentUser.name : 'Warga';
            const date = new Date().toISOString().split('T')[0];

            appData.guestbook.unshift({ name, date, message });
            saveToStorage();
            document.getElementById('form-guestbook').reset();
            renderGuestbook();
            alert('Catatan berhasil dikirim ke buku tamu desa.');
        }

        function renderGuestbook() {
            const list = document.getElementById('guestbook-list');
            list.innerHTML = appData.guestbook.map(gb => `
                <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-200 flex flex-col gap-1">
                    <div class="flex justify-between items-center">
                        <h4 class="font-bold text-sm text-slate-900"><i class="fas fa-user-circle text-brand-600 mr-1"></i> ${gb.name}</h4>
                        <span class="text-xs text-slate-400">${gb.date}</span>
                    </div>
                    <p class="text-xs text-slate-700 mt-1">${gb.message}</p>
                </div>
            `).join('');
        }

        // Kependudukan Sub-Tabs & Form
        function switchKepSub(sub) {
            document.querySelectorAll('.kep-sub-pane').forEach(el => el.classList.add('hidden'));
            document.getElementById(`kep-sub-${sub}`).classList.remove('hidden');
            document.querySelectorAll('.kep-sub-btn').forEach(btn => {
                btn.className = "kep-sub-btn px-4 py-2 rounded-xl font-bold text-sm bg-slate-200 text-slate-700 hover:bg-slate-300";
            });
            event.currentTarget.className = "kep-sub-btn px-4 py-2 rounded-xl font-bold text-sm bg-brand-600 text-white shadow";
        }

        function handleKependudukanSubmit(e, type) {
            e.preventDefault();
            const form = e.target;
            const formData = new FormData(form);
            const dataObj = {};
            formData.forEach((value, key) => { dataObj[key] = value; });

            if(type === 'lahir') {
                appData.kependudukanLahir.unshift(dataObj);
                renderKependudukanTables();
                alert('Laporan Kelahiran berhasil diajukan!');
            } else if(type === 'mati') {
                appData.kependudukanMati.unshift(dataObj);
                renderKependudukanTables();
                alert('Laporan Kematian berhasil diajukan!');
            } else if(type === 'pindah') {
                appData.kependudukanPindah.unshift(dataObj);
                renderKependudukanTables();
                alert('Laporan Pindah Datang berhasil diajukan!');
            }
            saveToStorage();
            form.reset();
            renderBeranda();
        }

        function renderKependudukanTables() {
            document.getElementById('tbody-lahir').innerHTML = appData.kependudukanLahir.map(item => `
                <tr>
                    <td class="p-3 font-semibold">${item.nama}</td>
                    <td class="p-3">${item.nik}</td>
                    <td class="p-3">${item.no_kk}</td>
                    <td class="p-3">${item.no_hp}</td>
                    <td class="p-3">${item.tanggal}</td>
                    <td class="p-3">${item.keterangan || '-'}</td>
                </tr>
            `).join('');

            document.getElementById('tbody-mati').innerHTML = appData.kependudukanMati.map(item => `
                <tr>
                    <td class="p-3 font-semibold">${item.nama}</td>
                    <td class="p-3">${item.nik}</td>
                    <td class="p-3">${item.no_kk}</td>
                    <td class="p-3">${item.no_hp}</td>
                    <td class="p-3">${item.tanggal}</td>
                    <td class="p-3">${item.sebab}</td>
                </tr>
            `).join('');

            document.getElementById('tbody-pindah').innerHTML = appData.kependudukanPindah.map(item => `
                <tr>
                    <td class="p-3 font-semibold">${item.nama}</td>
                    <td class="p-3">${item.nik}</td>
                    <td class="p-3">${item.no_kk}</td>
                    <td class="p-3">${item.no_hp}</td>
                    <td class="p-3">${item.asal_tujuan}</td>
                    <td class="p-3">${item.alasan}</td>
                </tr>
            `).join('');
        }

        // Lingkungan Sosial Handler
        function handleLaporanSosialSubmit(e) {
            e.preventDefault();
            const kategori = document.getElementById('ls-kategori').value;
            const judul = document.getElementById('ls-judul').value;
            const rw = document.getElementById('ls-rw').value;
            const rt = document.getElementById('ls-rt').value;
            const tanggal = document.getElementById('ls-tanggal').value;
            const deskripsi = document.getElementById('ls-deskripsi').value;
            const foto = document.getElementById('ls-foto').value;

            appData.laporanSosial.unshift({ id: Date.now(), kategori, judul, rw, rt, tanggal, deskripsi, foto });
            saveToStorage();
            closeModal('laporan-sosial-modal');
            document.getElementById('form-laporan-sosial').reset();
            renderLingkungan();
            renderBeranda();
            alert('Laporan Lingkungan Sosial berhasil dipublikasikan!');
        }

        function filterLingkungan(cat) {
            document.querySelectorAll('.ling-filter-btn').forEach(btn => {
                btn.className = "ling-filter-btn px-4 py-2 rounded-xl font-bold text-sm bg-slate-200 text-slate-700 hover:bg-slate-300";
            });
            event.currentTarget.className = "ling-filter-btn px-4 py-2 rounded-xl font-bold text-sm bg-brand-600 text-white shadow";
            renderLingkungan(cat);
        }

        function renderLingkungan(filter = 'all') {
            const grid = document.getElementById('lingkungan-grid');
            let data = appData.laporanSosial;
            if(filter !== 'all') {
                data = data.filter(item => item.kategori === filter);
            }

            grid.innerHTML = data.map(item => `
                bg-white p-5 rounded-2xl shadow-md border border-slate-100 flex flex-col justify-between">
                    <div>
                        <div class="h-48 rounded-xl overflow-hidden mb-3 bg-slate-100">
                            <img src="${item.foto}" class="w-full h-full object-cover" onerror="this.src='https://images.unsplash.com/photo-1500382017468-9049fed747ef?auto=format&fit=crop&q=80&w=600'">
                        </div>
                        <span class="bg-brand-100 text-brand-800 text-xs font-bold px-2.5 py-1 rounded-md">${item.kategori}</span>
                        <h4 class="font-bold text-base text-slate-900 mt-2">${item.judul}</h4>
                        <p class="text-xs text-slate-500 mt-1"><i class="fas fa-map-marker-alt text-brand-600 mr-1"></i> ${item.rw} / ${item.rt} | <i class="fas fa-calendar mr-1"></i> ${item.tanggal}</p>
                        <p class="text-xs text-slate-700 mt-2">${item.deskripsi}</p>
                    </div>
                </div>
            `).join('');
        }

        // Data RW Table & Filter
        function renderRwTable() {
            const filterRw = document.getElementById('select-filter-rw').value;
            let data = appData.rwData;
            if(filterRw !== 'all') {
                data = data.filter(d => d.rw === filterRw);
            }

            const tbody = document.getElementById('tbody-rw');
            tbody.innerHTML = data.map(d => `
                <tr>
                    <td class="p-3 font-bold text-brand-800">${d.rw}</td>
                    <td class="p-3 font-bold">${d.warga.toLocaleString('id-ID')}</td>
                    <td class="p-3">${d.warga} (${d.l} L / ${d.p} P)</td>
                    <td class="p-3">${d.kk}</td>
                    <td class="p-3">${d.pusHamil}</td>
                    <td class="p-3">${d.pusKb}</td>
                    <td class="p-3">${d.bkb}</td>
                    <td class="p-3">${d.bkr}</td>
                    <td class="p-3">${d.bkl}</td>
                    <td class="p-3">${d.uppks}</td>
                </tr>
            `).join('');
        }

        // Admin Actions
        function switchAdminSub(sub) {
            document.querySelectorAll('.adm-sub-pane').forEach(el => el.classList.add('hidden'));
            document.getElementById(`adm-sub-${sub}`).classList.remove('hidden');
            document.querySelectorAll('.admin-sub-btn').forEach(btn => {
                btn.className = "admin-sub-btn p-4 rounded-2xl bg-white text-slate-700 hover:bg-slate-100 font-bold text-sm shadow border text-center";
            });
            event.currentTarget.className = "admin-sub-btn p-4 rounded-2xl bg-brand-600 text-white font-bold text-sm shadow text-center";
        }

        function handleAdminPengumuman(e) {
            e.preventDefault();
            const title = document.getElementById('adm-p-title').value;
            const content = document.getElementById('adm-p-content').value;
            const date = new Date().toISOString().split('T')[0];

            appData.pengumuman.unshift({ title, date, content });
            saveToStorage();
            e.target.reset();
            renderBeranda();
            alert('Pengumuman resmi desa berhasil dipublikasikan!');
        }

        function handleAdminRwUpdate(e) {
            e.preventDefault();
            const rwName = document.getElementById('adm-rw-name').value;
            const warga = parseInt(document.getElementById('adm-rw-warga').value);
            const l = parseInt(document.getElementById('adm-rw-l').value);
            const p = parseInt(document.getElementById('adm-rw-p').value);
            const kk = parseInt(document.getElementById('adm-rw-kk').value);
            const pusHamil = parseInt(document.getElementById('adm-rw-pus').value);

            const index = appData.rwData.findIndex(d => d.rw === rwName);
            if(index !== -1) {
                appData.rwData[index].warga = warga;
                appData.rwData[index].l = l;
                appData.rwData[index].p = p;
                appData.rwData[index].kk = kk;
                appData.rwData[index].pusHamil = pusHamil;
                saveToStorage();
                renderRwTable();
                renderBeranda();
                initCharts();
                alert(`Data statistik ${rwName} berhasil diperbarui.`);
            }
        }

        function handleAdminSetting(e) {
            e.preventDefault();
            alert('Pengaturan identitas desa berhasil disimpan.');
        }

        function renderAdminModList() {
            const list = document.getElementById('admin-mod-list');
            if(!list) return;
            list.innerHTML = appData.laporanSosial.map(item => `
                <div class="flex justify-between items-center bg-slate-50 p-3 rounded-xl border">
                    <div>
                        <h4 class="font-bold text-sm">${item.judul} (${item.rw})</h4>
                        <p class="text-xs text-slate-500">${item.kategori} - ${item.tanggal}</p>
                    </div>
                    <button onclick="deleteLaporanSosial(${item.id})" class="bg-red-500 hover:bg-red-600 text-white text-xs px-3 py-1.5 rounded-lg shadow"><i class="fas fa-trash"></i> Hapus</button>
                </div>
            `).join('');
        }

        function deleteLaporanSosial(id) {
            if(confirm('Yakin ingin menghapus laporan ini?')) {
                appData.laporanSosial = appData.laporanSosial.filter(i => i.id !== id);
                saveToStorage();
                renderLingkungan();
                renderBeranda();
                renderAdminModList();
                alert('Laporan berhasil dihapus.');
            }
        }

        // ==================== EXPORT UTILS (EXCEL & PDF) ====================
        
        // 1. Ekspor ke Excel via SheetJS
        function exportTableToExcel(tableId, filename = 'Data_Desa_Cicangkanghilir.xlsx') {
            const table = document.getElementById(tableId);
            if(!table) {
                alert('Tabel tidak ditemukan.');
                return;
            }
            const wb = XLSX.utils.table_to_book(table, {sheet: "Laporan Desa"});
            XLSX.writeFile(wb, filename);
        }

        // 2. Ekspor ke PDF via jsPDF & AutoTable (Kop Surat Resmi Pemerintah KBB)
        function exportTableToPDF(titleText, tableId) {
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF('l', 'mm', 'a4'); // Landscape A4

            // Kop Surat Pemerintah
            doc.setFont("helvetica", "bold");
            doc.setFontSize(14);
            doc.text("PEMERINTAH KABUPATEN BANDUNG BARAT", 148, 15, { align: "center" });
            doc.setFontSize(12);
            doc.text("KECAMATAN CIPONGKOR", 148, 22, { align: "center" });
            doc.setFontSize(16);
            doc.text("DESA CICANGKANGHILIR", 148, 30, { align: "center" });
            
            doc.setFont("helvetica", "normal");
            doc.setFontSize(9);
            doc.text("Jl. Cijambe No. 5, Cicangkanghilir, Cipongkor, Kab. Bandung Barat, Kode Pos 40564", 148, 36, { align: "center" });
            
            // Garis Kop Surat
            doc.setLineWidth(0.8);
            doc.line(14, 40, 283, 40);
            doc.setLineWidth(0.2);
            doc.line(14, 41, 283, 41);

            // Judul Laporan
            doc.setFont("helvetica", "bold");
            doc.setFontSize(12);
            doc.text(titleText.toUpperCase(), 148, 52, { align: "center" });

            doc.setFont("helvetica", "normal");
            doc.setFontSize(9);
            const todayStr = new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
            doc.text(`Tanggal Cetak: ${todayStr}`, 14, 60);

            // AutoTable dari HTML Table
            doc.autoTable({
                html: `#${tableId}`,
                startY: 65,
                theme: 'grid',
                headStyles: { fillColor: [22, 163, 74] }, // Warna brand green
                styles: { fontSize: 8, cellPadding: 3 }
            });

            // Tanda Tangan Kepala Desa
            const finalY = doc.lastAutoTable.finalY + 15;
            const pageHeight = doc.internal.pageSize.height;
            let signY = finalY > pageHeight - 40 ? pageHeight - 40 : finalY;

            doc.text("Cicangkanghilir, " + todayStr, 220, signY);
            doc.text("Kepala Desa Cicangkanghilir,", 220, signY + 5);
            doc.setFont("helvetica", "bold");
            doc.text("AJID JAENUDIN, S.IP.", 220, signY + 25);
            doc.setFont("helvetica", "normal");
            doc.text("NIP. 19730406 200501 1 007", 220, signY + 30);

            doc.save(`${titleText.replace(/\s+/g, '_')}_Cicangkanghilir.pdf`);
        }

        // Charts Initialization
        function initCharts() {
            // Chart Age (Profil)
            const ctxAge = document.getElementById('chartAge');
            if(ctxAge) {
                if(window.myChartAge) window.myChartAge.destroy();
                window.myChartAge = new Chart(ctxAge, {
                    type: 'doughnut',
                    data: {
                        labels: ['Balita (0-5 Thn)', 'Anak & Remaja (6-18 Thn)', 'Usia Produktif (19-55 Thn)', 'Lansia (>55 Thn)'],
                        datasets: [{
                            data: [850, 1920, 4310, 1370],
                            backgroundColor: ['#22c55e', '#3b82f6', '#f59e0b', '#ef4444']
                        }]
                    },
                    options: { responsive: true, maintainAspectRatio: false }
                });
            }

            // Chart Edu (Profil)
            const ctxEdu = document.getElementById('chartEdu');
            if(ctxEdu) {
                if(window.myChartEdu) window.myChartEdu.destroy();
                window.myChartEdu = new Chart(ctxEdu, {
                    type: 'bar',
                    data: {
                        labels: ['Tidak Sekolah', 'SD / Sederajat', 'SMP / Sederajat', 'SMA / Sederajat', 'Diploma / Sarjana'],
                        datasets: [{
                            label: 'Jumlah Warga',
                            data: [420, 2950, 2410, 2120, 550],
                            backgroundColor: '#15803d'
                        }]
                    },
                    options: { responsive: true, maintainAspectRatio: false }
                });
            }

            // Chart RW Bar (Data RW)
            const ctxRw = document.getElementById('chartRwBar');
            if(ctxRw) {
                if(window.myChartRw) window.myChartRw.destroy();
                window.myChartRw = new Chart(ctxRw, {
                    type: 'bar',
                    data: {
                        labels: appData.rwData.map(d => d.rw),
                        datasets: [{
                            label: 'Total Warga per RW',
                            data: appData.rwData.map(d => d.warga),
                            backgroundColor: '#16a34a'
                        }]
                    },
                    options: { responsive: true, maintainAspectRatio: false }
                });
            }
        }

        // Initial Load
        window.onload = function() {
            renderAuthUI();
            renderBeranda();
            renderKependudukanTables();
            renderLingkungan();
            renderRwTable();
            initCharts();
        };
    </script>
